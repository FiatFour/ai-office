{
  "name": "agent-works",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "bin": {
    "agent-works": "bin/agent-works.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "agent-works": "node bin/agent-works.ts",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.base.json",
    "test": "vitest run",
    "test:bench-live": "vitest run bench/test/task-setup.test.ts bench/test/closure.test.ts bench/test/cage-mount.test.ts bench/test/arms.test.ts bench/test/cli.test.ts bench/test/factory.test.ts bench/test/once.test.ts",
    "check:sources": "node scripts/check-sources.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "20.19.43",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
