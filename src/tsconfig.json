{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "checkJs": false,
    "resolveJsonModule": true,
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mjs"],
  "exclude": ["dist", "node_modules"]
}
